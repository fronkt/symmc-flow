diff --git a/molcrystalflow/configs/ours_inference_A.yaml b/molcrystalflow/configs/ours_inference_A.yaml
new file mode 100644
index 0000000..f4f2eba
--- /dev/null
+++ b/molcrystalflow/configs/ours_inference_A.yaml
@@ -0,0 +1,52 @@
+# N3 MCF-A sampling (symmc-flow tasks/n3_protocol.md sec. 3.2 "(ii-A)"). inference.py merges this launch config
+# OVER the checkpoint's config.yaml, so it composes ours_molcrystal_A (refit lattice prior, 16 atom types).
+# Keys that differ per call interpolate to n3_set_on_command_line and raise if not set. Every call:
+# (one visible GPU: run_sampling's Trainer(strategy='ddp', devices='auto') would shard the set across GPUs)
+#   CUDA_VISIBLE_DEVICES=<one GPU> N3_ROOT=<symmc-flow> python molcrystalflow/experiments/inference.py --config-name=ours_inference_A \
+#     inference.ckpt_path=<ckpt> data.cache_dir=<n3_mcf/valsel_as_test|test|devtest> inference.num_samples=16 \
+#     interpolant.sampling.num_timesteps=50 interpolant.rots.sample_schedule=exp interpolant.rots.exp_rate=<s_uR> \
+#     interpolant.trans.scaling=<s_uF> inference.output_dir=<unique> inference.inference_dir=<unique> \
+#     inference.save_trajectories=False data.loader.num_workers=4 inference.seed=<200000 + 1000 s + split>
+defaults:
+  - ours_molcrystal_A
+  - _self_
+
+n3_set_on_command_line: ???
+
+data:
+  cache_dir: ${n3_set_on_command_line}
+  loader:
+    num_workers: 4
+
+interpolant:
+  rots:
+    sample_schedule: exp
+    exp_rate: ${n3_set_on_command_line}
+  trans:
+    scaling: ${n3_set_on_command_line}
+  sampling:
+    num_timesteps: 50
+
+# training seed / run name: not recorded here (this merge would overwrite the checkpoint's own values);
+# they are read from <ckpt_dir>/config.yaml
+experiment:
+  seed: null
+  wandb:
+    name: null
+
+inference:
+  inference_dir: ${n3_set_on_command_line}
+  name: n3_mcfA_inference
+  seed: ${n3_set_on_command_line}
+  task: null
+  output_dir: ${n3_set_on_command_line}
+  ckpt_path: ${n3_set_on_command_line}
+  use_gpu: True
+  num_gpus: 1
+  num_samples: 16
+  save_trajectories: False
+  gt_lattice_trans: false         # MCF-A generates lattice and centroids
+
+hydra:
+  run:
+    dir: ${inference.inference_dir}
