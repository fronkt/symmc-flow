@@ -0,0 +1,32 @@
+# N3 MCF-A (symmc-flow tasks/n3_protocol.md sec. 3.2 "(ii-A)"): released joint objective = molcrystal.yaml +
+# P1 vocabulary, our paths, the refit lattice prior (ours_lattice.yaml, written by scripts/n3_mcf_export.py),
+# and the same step budget / patience conversion as MCF-R. Seed (mandatory: a call without it raises)
+# and run name on the command line:
+#   WANDB_MODE=offline N3_ROOT=<symmc-flow> python molcrystalflow/experiments/train.py \
+#     --config-name=ours_molcrystal_A experiment.seed=<s> experiment.wandb.name=n3_mcfA_s<s>
+defaults:
+  - molcrystal
+  - ours_paths
+  - ours_lattice
+  - _self_
+
+# a plain '???' would not override molcrystal.yaml's 123 (Hydra merges keep the value); an interpolation does
+n3_set_on_command_line: ???
+
+model:
+  bb_embedder:
+    num_atom_types: 16            # P1: Mg, As, Se, Te -> 12-15
+    p6_scatter_pooling: false     # P6 (opt-in; only after its box gate passes)
+
+interpolant:
+  rots:
+    p6_vectorized_prior: false    # P6 (opt-in; only after its box gate passes)
+
+experiment:
+  seed: ${n3_set_on_command_line}  # mandatory: experiment.seed=<s> (the released 123 is never used)
+  trainer:
+    max_epochs: 1715              # 24,010 optimizer steps at ceil(1687/128) = 14 steps per epoch
+  lr_scheduler:
+    patience: 61                  # 62 x 14 = 868 steps (MCF's run: 11 x 79 = 869)
+  wandb:
+    name: n3_mcfA_s${experiment.seed}
